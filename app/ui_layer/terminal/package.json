{
  "name": "craftbot-terminal",
  "private": true,
  "version": "0.1.0",
  "description": "CraftBot terminal edition: a React + Ink client of the CraftBot backend",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/craftbot-tui.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "ansi-escapes": "7.3.0",
    "chalk": "6.0.1",
    "cli-truncate": "6.1.1",
    "highlight.js": "11.11.2",
    "i18next": "23.16.8",
    "ink": "8.0.0",
    "lowlight": "3.3.0",
    "marked": "18.1.2",
    "react": "19.3.1",
    "react-i18next": "14.1.3",
    "react-redux": "9.3.0",
    "slice-ansi": "9.0.1",
    "string-width": "8.3.0",
    "strip-ansi": "7.2.0",
    "wrap-ansi": "10.0.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/ws": "8.18.2",
    "@xterm/headless": "6.0.0",
    "esbuild": "0.28.2",
    "qrcode": "1.5.4",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
