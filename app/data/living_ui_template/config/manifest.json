{
  "id": "{{PROJECT_ID}}",
  "name": "{{PROJECT_NAME}}",
  "version": "1.0.0",
  "description": "{{PROJECT_DESCRIPTION}}",
  "author": "CraftBot Agent",
  "livingUIVersion": "1.0",
  "features": [],
  "createdAt": "{{CREATED_AT}}",
  "entrypoint": {
    "frontend": "frontend/main.tsx",
    "backend": "pb_hooks"
  },
  "ports": {
    "frontend": {{PORT}},
    "backend": {{BACKEND_PORT}}
  },
  "pipeline": {
    "backend": {
      "engine": "pocketbase",
      "health": "http://localhost:{{BACKEND_PORT}}/api/health"
    },
    "frontend": {
      "cwd": ".",
      "install": "npm install",
      "build": "npm run build:debug",
      "start": "npm run preview -- --port {{PORT}}",
      "health": null
    }
  },
  "agentAwareness": {
    "enabled": true,
    "stateReportInterval": 1000,
    "reportComponents": true,
    "reportUserInputs": true,
    "reportVisibleText": true
  },
  "theme": "{{THEME}}"
}
