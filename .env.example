# CraftBot: optional environment variables
#
# API keys are NOT read from this file or from any .env file. Enter your LLM
# API key in the browser onboarding on first start (change it later under
# Settings). CraftBot stores it in app/config/settings.json in its data folder.
#
# Everything below is optional and read from the process environment:
#   - Docker Compose: copy this file to .env next to docker-compose.yml.
#     Compose reads .env and passes these values into the container.
#   - Source install: set them in the terminal before running craftbot.py
#     (macOS/Linux: export NAME=value, Windows PowerShell: $env:NAME = "value").
# Leave a value empty to keep the default.

# --- Proxy ------------------------------------------------------------------
# Used by every download (Python, pip, npm, Node.js) and by CraftBot itself.
# Keep localhost in NO_PROXY so CraftBot can reach its own servers.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1

# --- Mirrors ----------------------------------------------------------------
# Python packages, e.g. https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=
# npm packages, e.g. https://registry.npmmirror.com
npm_config_registry=
# Embedding model download, e.g. https://hf-mirror.com
HF_ENDPOINT=
# URL rewrites for CraftBot's runtime downloads (Python, Node.js, PocketBase,
# embedding model): semicolon-separated prefix=replacement pairs. Downloads
# are still checked against their pinned SHA-256 checksums.
# e.g. https://nodejs.org/dist/=https://npmmirror.com/mirrors/node/
CRAFTBOT_MIRRORS=

# --- Location (source install only; the Docker image sets both itself) -------
# Keep all CraftBot data and downloaded runtimes in this folder instead.
# CRAFTBOT_HOME=/path/to/craftbot-data
# Interface the UI and backend listen on (default: localhost only).
# CRAFTBOT_BIND_HOST=0.0.0.0
